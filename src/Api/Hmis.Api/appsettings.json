{
  "ConnectionStrings": {
    "HmisDatabase": ""
  },
  "Jwt": {
    "Issuer": "hmis-api",
    "Audience": "hmis-ui",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/hmis-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "RateLimiting": {
    "AuthPermitPerMinute": 10
  },
  "Identity": {
    "Security": {
      "MaxFailedAccessAttempts": 5,
      "LockoutMinutes": 15
    },
    "SeedAdmin": {
      "UserName": "superadmin",
      "FullName": "Super Administrator"
    }
  },
  "FileStorage": {
    "RootPath": "storage"
  },
  "Administration": {
    "HospitalName": "Hospital"
  },
  "AllowedHosts": "*"
}