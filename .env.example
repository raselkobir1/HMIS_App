# Copy to .env (never committed) and fill in. Used by docker-compose.yml.
# JWT signing key: random string of at least 32 characters.
HMIS_JWT_SIGNING_KEY=
# Initial Super Administrator password (only used when no active Super Administrator exists).
# Without it a fresh install has no login at all; the API logs "STARTUP CHECK FAILED" until it is set.
HMIS_SEED_ADMIN_PASSWORD=
# Demo staff and logins (admin1, reception1, cashier1, nurse1, doctor1 / password Demo@2026) for development only.
# Never set this on a production install.
HMIS_SEED_DEMO_DATA=false

# Optional overrides
# HMIS_DB_USER=hmis
# HMIS_DB_PASSWORD=hmis_dev_password
# HMIS_DB_PORT=5434
# HMIS_API_PORT=5380              # bound to 127.0.0.1 only; the UI container reaches the API over the compose network
# HMIS_UI_PORT=4380               # the only port other machines need; put a TLS reverse proxy in front of it in production
# HMIS_API_ENVIRONMENT=Production   # Development enables Swagger at http://localhost:5380/swagger
